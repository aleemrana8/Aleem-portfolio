# ──────────────────────────────────────
# Aleem Portfolio — Root Environment
# ──────────────────────────────────────

# Database (used by docker-compose)
DB_PASSWORD=change_this_password

# JWT Authentication (REQUIRED — no default fallback)
JWT_SECRET=change_this_to_a_random_64char_string

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# SMTP (required for contact form)
SMTP_USER=
SMTP_PASS=

# OpenAI (required for chatbot)
OPENAI_API_KEY=sk-...

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHATBOT_NAME=Ask Aleem AI
