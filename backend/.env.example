# ──────────────────────────────────────
# Aleem Portfolio — Backend Environment
# ──────────────────────────────────────

# PostgreSQL connection (required)
# For Neon: use pooled connection string
DATABASE_URL=postgresql://user:password@host:5432/portfolio?sslmode=require

# Direct connection for Prisma migrations (Neon requires this)
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/portfolio?sslmode=require

# JWT secret for admin auth (required)
JWT_SECRET=change_this_to_a_random_secret

# Server port
PORT=4000

# CORS allowed origins (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000

# Node environment
NODE_ENV=development

# OpenAI API key for RAG chatbot + embeddings (required for AI features)
OPENAI_API_KEY=sk-...

# Redis URL (optional — for caching)
REDIS_URL=redis://localhost:6379

# Email notifications via Gmail SMTP (optional)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL for email links
FRONTEND_URL=http://localhost:3000
